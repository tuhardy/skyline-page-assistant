{
  "manifest_version": 3,
  "name": "SKYLINE 真实页面助手",
  "version": "0.5.0",
  "description": "识别短信/语音设备并提供可切换功能包，在真实 SKYLINE 页面提供全局导航、IMEI 指导、确认后修改和延迟回读。",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "显示或隐藏 SKYLINE 页面助手"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/main_en.html",
        "https://*/main_en.html",
        "http://*/main_cn.html",
        "https://*/main_cn.html",
        "http://*/goip_imei_en.html",
        "https://*/goip_imei_en.html",
        "http://*/goip_imei_cn.html",
        "https://*/goip_imei_cn.html"
      ],
      "js": ["core/imei.js", "core/modules.js", "core/device-profile.js", "content/panel.js", "content/controller.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
